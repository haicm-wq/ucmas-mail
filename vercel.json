{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/ucmas-mail.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  }
}
